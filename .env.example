# slxt share – App-Einstellungen: als app.env speichern (0600). Das Tunnel-Token kommt allein in .env (TUNNEL_TOKEN=…).
# Niemals einchecken.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.org
SHARE_GEHEIM=            # 64 zufällige Hex-Zeichen: python3 -c "import secrets;print(secrets.token_hex(32))"
SHARE_ADMIN_MAILS=       # E-Mail-Adresse(n) der Admins (nach Bestätigung per Code)
SHARE_ADMIN_MAIL=        # bekommt die „Mehr Speicher“-Anfragen
